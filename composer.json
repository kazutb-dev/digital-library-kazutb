{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "barryvdh/laravel-dompdf": "^3.1",
        "endroid/qr-code": "^6.0",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^3.0",
        "picqer/php-barcode-generator": "^3.2",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
        "composer install",
        "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
        "@php artisan key:generate",
        "@php -r \"fwrite(STDOUT, 'Database migrations are a separate, explicitly approved operation.'.PHP_EOL);\"",
        "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php vendor/bin/phpunit"
        ],
        "test:postgres": [
            "bash scripts/dev/test-postgres.sh"
        ],
        "qa:ci": [
            "composer validate --strict --no-check-publish",
            "@php vendor/bin/pint --test",
            "@test:critical-paths",
            "npm run build"
        ],
        "test:internal": [
            "@php vendor/bin/phpunit --filter='Internal(Circulation|Copy)|InternalDocumentReviewWorkflow|InternalReviewWorkflow|InternalDashboardPage|InternalReviewPage'"
        ],
        "test:reservation-core": [
            "@php vendor/bin/phpunit --filter='Reservation(Read|Mutate)|InternalCirculation(CheckoutReturn|Readback)|InternalCopy(Read|Mutation|Retirement)'"
        ],
        "test:integration-reservations": [
            "@php vendor/bin/phpunit tests/Feature/Api/Integration/ReservationMutateTest.php tests/Feature/Api/Integration/ReservationReadTest.php tests/Feature/Api/Integration/ReservationMutateRetirementConsistencyTest.php"
        ],
        "test:stewardship": [
            "@php vendor/bin/phpunit --filter='Internal(Reader|Document)?ReviewWorkflow|ReviewIssues(Summary)?Db|IdentityMatchAudit|IdentityMappingE2E|Bridge(Users|Copies|BooksDocuments|Summary)Diagnostics?Db|LibraryHealthSummaryDb'"
        ],
        "dev:catalog-paths": [
            "@php vendor/bin/phpunit --filter='ReaderConvergenceTest|CatalogPageTest|BookPageTest|CatalogRecoveryIntegrationTest'"
        ],
        "test:catalog-paths": [
            "@dev:catalog-paths"
        ],
        "test:critical-paths": [
            "@php vendor/bin/phpunit --filter='BibliographyFormatterTest|CatalogDbSearchTest|BookDetailDbTest|AuthSessionMeTest|AuthSessionLifecycleTest|LoginTest|ReservationReadTest|ReservationMutateTest|AccountReservationsTest|InternalCirculationCheckoutReturnTest|InternalCirculationRenewalTest|InternalCirculationReadbackTest|DocumentManagementTest|IntegrationRateLimitTest'"
        ],
        "dev:critical-paths": [
            "@test:critical-paths"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
