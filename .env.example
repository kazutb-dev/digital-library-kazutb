APP_NAME="Digital Library"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
REPOSITORY_READ_RATE_LIMIT=120
REPOSITORY_USAGE_RETENTION_DAYS=1095
LIBRARY_TIMEZONE=Asia/Almaty
APP_LIVE_SYNC=true
APP_LOCALE=kk
APP_FALLBACK_LOCALE=kk
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digital_library
DB_USERNAME=library_user
DB_PASSWORD=change_me

POSTGRES_DB=digital_library
POSTGRES_USER=library_user
POSTGRES_PASSWORD=change_me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

REPORTS_OFFICIAL_RETENTION_YEARS=10
REPORTS_EXPORT_RETENTION_DAYS=365
REPORTS_MAX_CUSTOM_PERIOD_DAYS=366
REPORTS_MAX_LIVE_ROWS=10000
REPORTS_MAX_EXPORT_BYTES=52428800
REPORTS_EXPORT_LEASE_SECONDS=300
REPORTS_EXPORT_DISPATCH_BATCH=100
REPORTS_EXPORT_USER_ACTIVE_LIMIT=4
REPORTS_EXPIRED_SNAPSHOT_ACTION=preserve

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

EXTERNAL_AUTH_LOGIN_URL=http://crm.local/api/login
EXTERNAL_AUTH_LOGOUT_URL=http://crm.local/api/logout

# Break-glass local password login for accounts flagged auth_source=local_break_glass.
# Off by default; enable only for controlled testing or if AD is unreachable, then disable.
BREAK_GLASS_LOGIN_ENABLED=false
INTEGRATION_ALLOWED_TOKENS=
FRONTEND_CATALOG_PROXY_URL=http://localhost:5173/api/v1/catalog
VITE_HMR_HOST=

# Read-only operational metadata shown in /admin/integrations.
# Backup/restore itself remains an infrastructure operation.
BACKUP_PROVIDER=
BACKUP_SCHEDULE=
BACKUP_LAST_SUCCESS_AT=
RECOVERY_RUNBOOK_URL=

# Verified contract end dates (YYYY-MM-DD). Leave blank until the library has
# confirmed the signed agreement; licensed/partner records stay private drafts.
EXTERNAL_RESOURCE_IPR_EXPIRES_AT=
EXTERNAL_RESOURCE_RMEB_EXPIRES_AT=
EXTERNAL_RESOURCE_ELIBRARY_EXPIRES_AT=
EXTERNAL_RESOURCE_POLPRED_EXPIRES_AT=
EXTERNAL_RESOURCE_ATU_EXPIRES_AT=
EXTERNAL_RESOURCE_RNTB_EXPIRES_AT=
EXTERNAL_RESOURCE_KOZYBAYEV_EXPIRES_AT=
EXTERNAL_RESOURCE_ASTANA_CBS_EXPIRES_AT=
EXTERNAL_RESOURCE_ARNAIY_EXPIRES_AT=
EXTERNAL_RESOURCE_EXPIRY_NOTICE_DAYS=0,1,7,14,30,60,90
EXTERNAL_RESOURCE_ANALYTICS_RETENTION_DAYS=395
EXTERNAL_RESOURCE_PUBLIC_RATE_LIMIT=120
EXTERNAL_RESOURCE_HEALTH_TIMEOUT=8
EXTERNAL_RESOURCE_HEALTH_CONNECT_TIMEOUT=4

API_KEY_21ST=
AGENT_21ST_SLUG=frontend-dev-agent
AGENT_21ST_TOKEN_EXPIRES_IN=1h

# MCP / AI tooling
CONTEXT7_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=
STITCH_API_KEY=
SENTRY_ACCESS_TOKEN=
SENTRY_HOST=
MCP_DISABLE_SKILLS=
EMBEDDED_AGENT_PROVIDER=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PWD=
MCP_REDIS_LOG_LEVEL=INFO

# Obsidian memory sync
OBSIDIAN_VAULT_ROOT=
OBSIDIAN_SYNC_INTERVAL=10

VITE_APP_NAME="${APP_NAME}"

# KazUTB Active Directory. Store bind credentials only in deployment secrets.
AD_ENABLED=false
AD_HOST=
AD_PORT=636
AD_USE_SSL=true
AD_TIMEOUT=5
AD_BIND_DN=
AD_BIND_PASSWORD=
AD_BASE_DN=
AD_LOGIN_FIELD=samaccountname
AD_USER_FILTER="(&(objectCategory=person)(objectClass=user))"
AD_REQUIRE_CERT=true
AD_CA_CERT_PATH=/app/docker/certs/kaztbu-dc1-ca.crt
