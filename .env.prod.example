# ──────────────────────────────────────────────────────────────
#  .env.prod.example — PRODUCTION environment template
#  NEVER commit .env.prod to git.
#  Set secrets via CI/CD secrets (GitHub Actions / Vault)
#  docker compose -f docker-compose.prod.yml up -d
# ──────────────────────────────────────────────────────────────

APP_NAME="Digital Library"
APP_ENV=production
APP_KEY=REPLACE_WITH_BASE64_KEY
APP_DEBUG=false
APP_URL=https://elibrary.kaztbu.edu.kz
REPOSITORY_READ_RATE_LIMIT=120
REPOSITORY_USAGE_RETENTION_DAYS=1095

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# PostgreSQL — PROD
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=digital_library_recovered
DB_USERNAME=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

POSTGRES_DB=digital_library_recovered
POSTGRES_USER=REPLACE_WITH_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=360

REPORTS_OFFICIAL_RETENTION_YEARS=10
REPORTS_EXPORT_RETENTION_DAYS=365
REPORTS_MAX_CUSTOM_PERIOD_DAYS=366
REPORTS_MAX_LIVE_ROWS=10000
REPORTS_MAX_EXPORT_BYTES=52428800
REPORTS_EXPORT_LEASE_SECONDS=300
REPORTS_EXPORT_DISPATCH_BATCH=100
REPORTS_EXPORT_USER_ACTIVE_LIMIT=4
REPORTS_EXPIRED_SNAPSHOT_ACTION=preserve
EXTERNAL_RESOURCE_EXPIRY_NOTICE_DAYS=0,1,7,14,30,60,90
EXTERNAL_RESOURCE_ANALYTICS_RETENTION_DAYS=395
EXTERNAL_RESOURCE_PUBLIC_RATE_LIMIT=120
EXTERNAL_RESOURCE_HEALTH_TIMEOUT=8
EXTERNAL_RESOURCE_HEALTH_CONNECT_TIMEOUT=4
CACHE_STORE=database

# Read-only operational metadata. Backup/restore stays an infrastructure task.
BACKUP_PROVIDER=
BACKUP_SCHEDULE=
BACKUP_LAST_SUCCESS_AT=
RECOVERY_RUNBOOK_URL=

# Verified local backups are mandatory. Set this to a separately mounted or
# replicated destination before claiming offsite backup coverage.
LIBRARY_BACKUP_OFFSITE_ROOT=
LIBRARY_BACKUP_RETENTION_DAYS=30

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS="noreply@library.kazutb.kz"
MAIL_FROM_NAME="KazUTB Digital Library"

# External CRM auth
EXTERNAL_AUTH_LOGIN_URL=https://crm.kazutb.kz/api/login
EXTERNAL_AUTH_LOGOUT_URL=https://crm.kazutb.kz/api/logout
INTEGRATION_ALLOWED_TOKENS=REPLACE_WITH_PRODUCTION_TOKEN

# APP image version for docker-compose.prod.yml
APP_IMAGE=library-app
APP_VERSION=latest

VITE_APP_NAME="${APP_NAME}"
