# ──────────────────────────────────────────────────────────────
#  .env.dev.example — DEV environment template
#  Copy to .env before running docker-compose.dev.yml locally
#  docker compose -f docker-compose.dev.yml up --build -d
# ──────────────────────────────────────────────────────────────

APP_NAME="Digital Library [DEV]"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_LIVE_SYNC=true
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL — DEV (Docker service name is 'postgres')
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=digital_library_dev
DB_USERNAME=library_user
DB_PASSWORD=dev_secret_change_me

POSTGRES_DB=digital_library_dev
POSTGRES_USER=library_user
POSTGRES_PASSWORD=dev_secret_change_me
POSTGRES_PORT=5432

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="dev@library.local"
MAIL_FROM_NAME="${APP_NAME}"

# External CRM auth (stub URL for local dev)
EXTERNAL_AUTH_LOGIN_URL=http://crm.local/api/login
EXTERNAL_AUTH_LOGOUT_URL=http://crm.local/api/logout
INTEGRATION_ALLOWED_TOKENS=dev-token-replace-me

# Vite HMR
VITE_HMR_HOST=localhost
VITE_APP_NAME="${APP_NAME}"

# Frontend proxy for catalog (Vite dev server)
FRONTEND_CATALOG_PROXY_URL=http://localhost:5173/api/v1/catalog
